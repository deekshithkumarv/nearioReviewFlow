# Copy to .env (Node scripts) and .dev.vars (wrangler preview). Never commit real values.

# --- Required ---------------------------------------------------------------
# Neon serverless Postgres connection string
DATABASE_URL=
# At least 32 random characters, used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# Public base URL for canonical links, Open Graph, robots.txt and sitemap.xml
# (defaults to https://nearioreviewflow.glcdemo.workers.dev)
NEXT_PUBLIC_SITE_URL=

# Invite emails. Use ONE of these. Without either, admins get a pre-filled email draft instead.
# Option 1: your Gmail through a Google Apps Script web app
GMAIL_WEBHOOK_URL=
GMAIL_WEBHOOK_SECRET=
# Option 2: Resend (EMAIL_FROM must be on a domain you verified with Resend)
RESEND_API_KEY=
EMAIL_FROM=

# --- Scripts only (not used by the app) --------------------------------------
# npm run seed: creates the first super admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
