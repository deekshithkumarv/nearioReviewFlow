# Neon Serverless PostgreSQL Database Connection String
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session Secret (minimum 32 characters) for HMAC-SHA256 cookie signing
SESSION_SECRET=replace_with_a_secure_random_32_char_secret_key_for_session

# Option 1: Personal Gmail via Google Apps Script Web App webhook (sends directly from your Gmail)
# GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GMAIL_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Option 2: Resend API key (requires a verified custom domain for EMAIL_FROM)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Neario ReviewFlow <invites@yourdomain.com>

